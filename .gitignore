# History files
.Rhistory
.Rapp.history
.DS_Store

# Session Data files
.RData

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
/*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# Shiny token, see https://shiny.rstudio.com/articles/shinyapps.html
rsconnect/

# Keep raw reads and regenerable filtered DADA2 FASTQs local. Track the final
# 2016 DADA2 products, QC, provenance, and compact per-run diagnostics so
# downstream analyses can be regenerated directly from the repository.
sequences/
results/dada2_2016/runs/*/filtered/
results/dada2_2016/**/.DS_Store

# Large analysis matrices are rebuilt by analysis/data_prep/.
data/derived/analysis_inputs/**/*.rds
data/derived/analysis_inputs/**/*.csv.gz

# Machine-specific session snapshots are regenerated when workflows run.
data/derived/analysis_inputs/audit/session_info_*.txt
results/diversity_2016/audit/session_info_*.txt

# Joined microbial inputs duplicate the tracked DADA2 products and are rebuilt
# by analysis/microbes/01_prepare_diversity.R. Keep the compact canonical 10K
# table and analysis metadata trackable.
results/diversity_2016/derived/diversity_input.rds
results/diversity_2016/derived/asv_sequence_metadata.csv
results/diversity_2016/derived/asv_taxonomy.csv

# Outputs from retired exploratory diversity scripts. These remain local but
# are not part of the current 10K workflow.
results/diversity_2016/audit/beta_analysis_summary.csv
results/diversity_2016/audit/predictor_coverage.csv
results/diversity_2016/audit/transformation_log.csv
results/diversity_2016/tables/alpha_diversity_by_sample.csv
results/diversity_2016/tables/alpha_diversity_habitat_summary.csv
results/diversity_2016/tables/alpha_habitat_models.csv
results/diversity_2016/tables/alpha_habitat_nonparametric_tests.csv
results/diversity_2016/tables/alpha_predictor_screen.csv
results/diversity_2016/tables/alpha_technical_batch_sensitivity.csv
results/diversity_2016/tables/beta_dispersion_test.csv
results/diversity_2016/tables/beta_permanova_habitat.csv
results/diversity_2016/tables/beta_predictor_screen.csv
results/diversity_2016/tables/beta_technical_batch_sensitivity.csv
results/diversity_2016/tables/bray_nmds_scores.csv
results/diversity_2016/tables/bray_pcoa_scores.csv
results/diversity_2016/tables/deep_sample_richness_loss_at_1000.csv
results/diversity_2016/tables/pcoa_axis_associations.csv
results/diversity_2016/tables/pcoa_high_axis2_samples.csv
results/diversity_2016/tables/rarefaction_depth_by_sample.csv
results/diversity_2016/tables/rarefaction_depth_summary.csv
results/diversity_2016/tables/recommended_depth_tiers.csv

# Slurm logs.
logs/*.out
logs/*.err

# Keep taxonomy references local; retain the directory documentation.
reference/*
