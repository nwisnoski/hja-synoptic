# History files
.Rhistory
.Rapp.history
.DS_Store

# Session Data files
.RData

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
/*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# Shiny token, see https://shiny.rstudio.com/articles/shinyapps.html
rsconnect/

# Keep raw reads and regenerable filtered DADA2 FASTQs local. Track the final
# 2016 DADA2 products, QC, provenance, and compact per-run diagnostics so
# downstream analyses can be regenerated directly from the repository.
sequences/
results/dada2_2016/runs/*/filtered/
results/dada2_2016/**/.DS_Store

# Large analysis matrices are rebuilt by analysis/data_prep/.
data/derived/analysis_inputs/**/*.rds
data/derived/analysis_inputs/**/*.csv.gz

# Slurm logs.
logs/*.out
logs/*.err

# Keep taxonomy references local; retain the directory documentation.
reference/*
!reference/README.md
